{
  "manifest_version": 3,
  "name": "LinkedIn Message Scheduler",
  "version": "1.0.0",
  "description": "Schedule LinkedIn messages with reminders and never miss a follow-up.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Message Scheduler"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": []
}
